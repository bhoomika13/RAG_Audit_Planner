        {
          "block_type": "line",
          "top": 63,
          "text": "1. Purpose"
        },
        {
          "block_type": "line",
          "top": 87,
          "text": "This policy defines approval authority levels for booking Order Intake and establishes requirements for Order Backlog"
        },
        {
          "block_type": "line",
          "top": 102,
          "text": "monitoring. This version supersedes v1.0 as part of the FY2025 controls enhancement program."
        },
        {
          "block_type": "line",
          "top": 129,
          "text": "2. Scope"
        },
        {
          "block_type": "line",
          "top": 156,
          "text": "Applies to all Orders booked as Order Intake and to periodic review of Order Backlog balances."
        },
        {
          "block_type": "line",
          "top": 183,
          "text": "3. Approval Authority Matrix"
        },
        {
          "block_type": "table",
          "top": 206.5,
          "rows": [
            [
              "Order Value",
              "Approver"
            ],
            [
              "Up to $100,000",
              "Sales Manager"
            ],
            [
              "$100,001 – $500,000",
              "Regional Finance Head"
            ],
            [
              "Above $500,000",
              "CFO"
            ],
            [
              "THRESHOLD UPDATE\nApproval thresholds increased from $50,000 / $250,000 to $100,000 / $500,000.",
              null
            ]
          ],
          "n_rows": 5,
          "n_cols": 2
        },
        {
          "block_type": "line",
          "top": 336,
          "text": "Approval must be documented and retained in the order file."
        },
        {
          "block_type": "line",
          "top": 366,
          "text": "4. Order Backlog Management"
        },
        {
          "block_type": "line",
          "top": 393,
          "text": "4.1 Review Frequency"
        },
        {
          "block_type": "line",
          "top": 414,
          "text": "Order Backlog is reviewed on a MONTHLY basis by the Finance team."
        },
        {
          "block_type": "line",
          "top": 438,
          "text": "4.2 Aging Calculation"
        },
        {
          "block_type": "line",
          "top": 456,
          "text": "Aging (Days) = Current Date - Original Order Booking Date"
        },
        {
          "block_type": "line",
          "top": 471,
          "text": "Aging (Months) = Aging (Days) ÷ 30 (approximate)"
        },
        {
          "block_type": "line",
          "top": 495,
          "text": "4.3 Flagging Criteria"
        },
        {
          "block_type": "line",
          "top": 516,
          "text": "Backlog items shall be flagged for review when EITHER:"
        },
        {
          "block_type": "line",
          "top": 537,
          "text": "- Aging (Days) > 180 days (6 months), OR"
        },
        {
          "block_type": "line",
          "top": 552,
          "text": "- No delivery milestone has been recorded in the system for 2 consecutive monthly review cycles"
        },
        {
          "block_type": "line",
          "top": 570,
          "text": "Flagged items require Finance Manager review to determine whether continued recognition remains appropriate."
        },
        {
          "block_type": "line",
          "top": 594,
          "text": "CONTROL ENHANCEMENT"
        },
        {
          "block_type": "line",
          "top": 618,
          "text": "Review frequency moved from quarterly to monthly; aging flag threshold reduced from 365 days to 180 days."
        },
        {
          "block_type": "line",
          "top": 651,
          "text": "5. Roles and Responsibilities"
