            ]
          ],
          "n_rows": 5,
          "n_cols": 4
        },
        {
          "block_type": "line",
          "top": 552,
          "text": "4.2 Sample Selection Approach"
        },
        {
          "block_type": "line",
          "top": 573,
          "text": "- Population: All orders booked Jul–Oct 2024 (n = 342)"
        },
        {
          "block_type": "line",
          "top": 591,
          "text": "- Sample size: 15 orders, judgmentally selected across 3 regions"
        },
        {
          "block_type": "line",
          "top": 609,
          "text": "- Stratification: Weighted toward orders >$50,000 and customers rated below B"
        },
        {
          "block_type": "line",
          "top": 639,
          "text": "5. Testing Procedures Performed"
        },
        {
          "block_type": "line",
          "top": 666,
          "text": "- Inspected PO documentation for existence and completeness"
        },
        {
          "block_type": "line",
          "top": 681,
          "text": "- Traced credit rating classification to Group Credit Risk system"
        },
        {
          "block_type": "line",
          "top": 699,
          "text": "- Recalculated booking date against PO receipt date per Section 5.4"
        },
        {
          "block_type": "line",
          "top": 717,
          "text": "- Verified Finance Manager sign-off where credit rating below B"
        },
        {
          "block_type": "line",
          "top": 750,
          "text": "CFO POLICY FRAMEWORK | CONTROLLED DOCUMENT Page 2"
        }
      ]
    },
