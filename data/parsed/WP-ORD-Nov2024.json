            ],
            [
              "3",
              "Review credit rating classification and Finance Manager sign-off for orde",
              "rs5 .r3a.t1e,d 5 b.3e.l2ow B",
              "KRI-003"
            ],
            [
              "4",
              "Confirm booking date aligns with PO receipt date",
              "5.4",
