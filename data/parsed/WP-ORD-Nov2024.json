        {
          "block_type": "line",
          "top": 63,
          "text": "1. Audit Objective"
        },
        {
          "block_type": "line",
          "top": 87,
          "text": "To assess whether Order Intake was recognized and measured in accordance with POL-ORD-001 v1.0, and to"
        },
        {
          "block_type": "line",
          "top": 102,
          "text": "evaluate the design and operating effectiveness of related controls (CTRL-REV-014)."
        },
        {
          "block_type": "line",
          "top": 129,
          "text": "2. Background and Scope"
        },
        {
          "block_type": "line",
          "top": 156,
          "text": "This audit plan was developed for the FY2024 Q4 audit cycle, covering Order Intake transactions booked between"
        },
        {
          "block_type": "line",
          "top": 168,
          "text": "July 2024 and October 2024. Scope includes:"
        },
        {
          "block_type": "line",
          "top": 189,
          "text": "- Hardware/Software orders"
        },
        {
          "block_type": "line",
          "top": 207,
          "text": "- Standalone Services orders"
        },
        {
          "block_type": "line",
          "top": 222,
          "text": "- Bundled multi-element arrangements"
        },
        {
          "block_type": "line",
          "top": 255,
          "text": "3. Key Risk Indicators (KRIs)"
        },
        {
          "block_type": "table",
          "top": 277.0,
          "rows": [
            [
              "KRI ID",
              "KRI Description",
              "Related Policy Clause",
              "Risk Rating"
            ],
            [
              "KRI-001",
              "Orders recognized without valid PO or contract",
              "Section 5.1",
              "High"
            ],
            [
              "KRI-002",
              "Orders booked based on PO only, without countersigned contra",
              "ctSection 5.2",
              "Medium"
            ],
            [
              "KRI-003",
              "Orders from low credit-rated customers booked without required",
              "sSigenc-toioffn 5.3.2",
              "High"
            ],
            [
              "KRI-004",
              "Order Intake booked prior to satisfying timing criteria",
              "Section 5.4",
              "Medium"
            ]
          ],
          "n_rows": 5,
          "n_cols": 4
        },
        {
          "block_type": "line",
          "top": 393,
          "text": "4. Audit Planning Steps"
        },
        {
          "block_type": "line",
          "top": 420,
          "text": "4.1 Step Mapping to Policy Clauses"
        },
        {
          "block_type": "table",
          "top": 440.0,
          "rows": [
            [
              "Step #",
              "Audit Step Description",
              "Policy Clause Tested",
              "Related KRI"
            ],
            [
              "1",
              "Verify existence of valid PO for sampled orders",
              "5.1",
